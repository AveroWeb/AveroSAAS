// Prisma schema — Agency SaaS
// Multi-tenant: every business entity is scoped to an Organization.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Core / Auth / Multi-tenant
// ---------------------------------------------------------------------------

enum Role {
  ADMIN // full access to the agency workspace
  MEMBER // operational access, limited financial visibility
  CLIENT // client portal only, scoped to their own Client record
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  clients          Client[]
  sites            Site[]
  domains          Domain[]
  hostings         Hosting[]
  tools            Tool[]
  plans            Plan[]
  subscriptions    Subscription[]
  maintenanceTasks MaintenanceTask[]
  incidents        Incident[]
  tasks            Task[]
  tickets          Ticket[]
  invoices         Invoice[]
  quotes           Quote[]
  activityLogs     ActivityLog[]
  notifications    Notification[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email        String @unique
  passwordHash String
  name         String
  role         Role   @default(MEMBER)

  // Set only for CLIENT-role users: which client they can see in the portal.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedMaintenanceTasks MaintenanceTask[] @relation("MaintenanceAssignee")
  assignedTasks            Task[]            @relation("TaskAssignee")
  ticketMessages           TicketMessage[]
  activityLogs             ActivityLog[]
  notifications            Notification[]

  @@index([organizationId])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

enum ClientStatus {
  ACTIVE
  PROSPECT
  INACTIVE
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  companyName String
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?      @db.Text
  status      ClientStatus @default(PROSPECT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  sites            Site[]
  domains          Domain[]
  hostings         Hosting[]
  tools            Tool[]
  subscriptions    Subscription[]
  maintenanceTasks MaintenanceTask[]
  incidents        Incident[]
  tasks            Task[]
  tickets          Ticket[]
  invoices         Invoice[]
  quotes           Quote[]
  activityLogs     ActivityLog[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Sites / Domains / Hosting / Tools
// ---------------------------------------------------------------------------

enum SiteType {
  WORDPRESS
  NEXTJS
  SHOPIFY
  WOOCOMMERCE
  WEBFLOW
  OTHER
}

enum SiteEnvironment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

enum SiteStatus {
  ACTIVE
  MAINTENANCE
  OFFLINE
}

model Site {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name        String
  url         String
  type        SiteType        @default(OTHER)
  environment SiteEnvironment @default(PRODUCTION)
  status      SiteStatus      @default(ACTIVE)

  repositoryUrl String?
  stagingUrl    String?
  launchedAt    DateTime?
  lastBackupAt  DateTime?
  notes         String?   @db.Text

  // Monitoring architecture (Phase 6): fields populated later by an external checker.
  monitoringEnabled Boolean   @default(false)
  lastCheckedAt     DateTime?
  isUp              Boolean?
  lastResponseMs    Int?
  sslExpiresAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains          Domain[]
  hostings         Hosting[]
  tools            Tool[]
  maintenanceTasks MaintenanceTask[]
  incidents        Incident[]
  tasks            Task[]
  tickets          Ticket[]
  uptimeChecks     UptimeCheck[]

  @@index([organizationId])
  @@index([clientId])
}

enum DomainStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  TRANSFERRED
}

model Domain {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  name         String
  isPrimary    Boolean      @default(false)
  registrar    String?
  registrarUrl String?
  expiresAt    DateTime?
  autoRenew    Boolean      @default(false)
  annualCost   Decimal?     @db.Decimal(10, 2)
  status       DomainStatus @default(ACTIVE)
  notes        String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([siteId])
  @@index([expiresAt])
}

model Hosting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  provider     String
  dashboardUrl String?
  serverType   String?
  accountRef   String? // account identifier, never a password
  monthlyCost  Decimal?  @db.Decimal(10, 2)
  annualCost   Decimal?  @db.Decimal(10, 2)
  renewsAt     DateTime?
  notes        String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([siteId])
  @@index([renewsAt])
}

model Tool {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  name        String
  category    String // e.g. "Hosting", "Repository", "Analytics", "AI", "Design"
  url         String?
  identifier  String? // username/handle, never a password
  monthlyCost Decimal? @db.Decimal(10, 2)
  notes       String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([siteId])
}

// ---------------------------------------------------------------------------
// Plans / Subscriptions (money)
// ---------------------------------------------------------------------------

model Plan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  monthlyPrice Decimal @db.Decimal(10, 2)
  description  String? @db.Text
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([organizationId])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Subscription {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  planId         String?
  plan           Plan?        @relation(fields: [planId], references: [id], onDelete: SetNull)

  monthlyPrice Decimal            @db.Decimal(10, 2)
  startDate    DateTime
  renewalDate  DateTime?
  status       SubscriptionStatus @default(ACTIVE)
  description  String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([organizationId])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Maintenance
// ---------------------------------------------------------------------------

enum MaintenanceFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum MaintenanceStatus {
  PENDING
  DONE
  CANCELLED
}

model MaintenanceTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  title       String
  description String?              @db.Text
  frequency   MaintenanceFrequency @default(ONCE)
  status      MaintenanceStatus    @default(PENDING)

  nextRunAt DateTime
  lastRunAt DateTime?

  assigneeId String?
  assignee   User?   @relation("MaintenanceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([siteId])
  @@index([nextRunAt])
}

// ---------------------------------------------------------------------------
// Incidents
// ---------------------------------------------------------------------------

enum IncidentStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IncidentPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model Incident {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  title       String
  description String?          @db.Text
  cause       String?          @db.Text
  solution    String?          @db.Text
  status      IncidentStatus   @default(NEW)
  priority    IncidentPriority @default(NORMAL)

  startedAt  DateTime  @default(now())
  resolvedAt DateTime?
  notes      String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events IncidentEvent[]

  @@index([organizationId])
  @@index([clientId])
  @@index([siteId])
  @@index([status])
}

model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  message   String
  createdAt DateTime @default(now())

  @@index([incidentId])
}

// Placeholder for automated uptime checks (Phase 6 monitoring integration).
model UptimeCheck {
  id     String @id @default(cuid())
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  checkedAt  DateTime @default(now())
  isUp       Boolean
  statusCode Int?
  responseMs Int?

  @@index([siteId])
  @@index([checkedAt])
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NORMAL)
  dueDate     DateTime?

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([siteId])
  @@index([dueDate])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Client portal: tickets
// ---------------------------------------------------------------------------

enum TicketStatus {
  TO_PROCESS
  IN_PROGRESS
  WAITING_CLIENT
  DONE
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Ticket {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  siteId         String?
  site           Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  number      Int            @unique @default(autoincrement())
  title       String
  description String?        @db.Text
  status      TicketStatus   @default(TO_PROCESS)
  priority    TicketPriority @default(NORMAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TicketMessage[]

  @@index([organizationId])
  @@index([clientId])
  @@index([siteId])
  @@index([status])
}

model TicketMessage {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Invoices (optional billing, Phase 4+)
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  PAID
  UNPAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  quoteId        String?       @unique
  quote          Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  amount    Decimal       @db.Decimal(10, 2)
  status    InvoiceStatus @default(UNPAID)
  issueDate DateTime      @default(now())
  dueDate   DateTime?
  paidAt    DateTime?
  notes     String?       @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Quotes (devis) — sent to a client for approval before becoming an Invoice
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  title       String
  description String?     @db.Text
  amount      Decimal     @db.Decimal(10, 2)
  status      QuoteStatus @default(DRAFT)
  issueDate   DateTime    @default(now())
  validUntil  DateTime?
  notes       String?     @db.Text

  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Activity log (client history timeline) & notifications
// ---------------------------------------------------------------------------

enum ActivityType {
  CLIENT_CREATED
  SITE_CREATED
  DOMAIN_RENEWED
  INCIDENT_OPENED
  INCIDENT_RESOLVED
  MAINTENANCE_DONE
  TASK_COMPLETED
  TICKET_CREATED
  TICKET_UPDATED
  SUBSCRIPTION_STARTED
  SUBSCRIPTION_CANCELLED
  PAYMENT_RECEIVED
  NOTE
  OTHER
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  type      ActivityType
  message   String
  createdAt DateTime     @default(now())

  @@index([organizationId])
  @@index([clientId])
  @@index([createdAt])
}

enum NotificationType {
  SITE_DOWN
  DOMAIN_EXPIRING
  HOSTING_RENEWAL
  MAINTENANCE_LATE
  TASK_LATE
  SUBSCRIPTION_RENEWAL
  TICKET_CREATED
  OTHER
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([organizationId])
  @@index([userId])
  @@index([isRead])
}
