# PostgreSQL connection string (Neon or any Postgres instance).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Anthropic API key, used by the AI agent (src/lib/ai) to parse free-text notes.
ANTHROPIC_API_KEY=""

# ScrapeGraphAI API key, used by the prospection feature to search and qualify leads.
SCRAPEGRAPH_API_KEY=""

# Used only by prisma/seed.ts to create the first admin account.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="Admin"
SEED_ORG_NAME="Mon Agence"
