# PostgreSQL connection string (Neon or any Postgres instance).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Anthropic API key, used by everything under src/lib/ai: the note-parsing agent
# and the in-app assistant chat bubble (src/lib/ai/chat-agent.ts).
ANTHROPIC_API_KEY=""

# ScrapeGraphAI API key, used by the prospection feature to search and qualify leads.
SCRAPEGRAPH_API_KEY=""

# VAPID key pair for Web Push (new-email notifications). Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the same value as VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Secret token an external cron caller (e.g. cron-job.org) must pass to trigger
# /api/cron/sync-emails. Generate with: openssl rand -hex 24
CRON_SECRET=""

# Used only by prisma/seed.ts to create the first admin account.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="Admin"
SEED_ORG_NAME="Mon Agence"
